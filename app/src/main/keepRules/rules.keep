# Project-specific R8 keep rules.
#
# This file lives in the `keepRules` source set (src/main/keepRules) and is
# picked up automatically by AGP 9.3+ because of the `.keep` extension. R8 and
# resource optimization are enabled for the release build type with
# `optimization { enable = true }` in app/build.gradle.kts - there is no
# `proguard-rules.pro` and no `proguardFiles` declaration.
#
# The default Android platform rules (equivalent to
# `getDefaultProguardFile("proguard-android-optimize.txt")`) are included
# automatically; opt out with `optimization.keepRules.includeDefault = false`.
#
# For more details, see
#   https://developer.android.com/topic/performance/app-optimization/keep-rules-overview

# Firebase Crashlytics
# Keep this app's own exception types so stack traces stay readable. Library
# exception classes do not need to be kept - Crashlytics resolves their names
# through the mapping file.
-keep class com.neilturner.aerialviews.** extends java.lang.Exception { *; }

# Firebase Perf network instrumentation is woven into Coil/OkHttp/XmlPull by the
# firebase-perf Gradle plugin. F-Droid has no Firebase Perf SDK on the classpath,
# so R8 cannot resolve these classes during minification — suppress them.
-dontwarn com.google.firebase.perf.network.FirebasePerfOkHttpClient
-dontwarn com.google.firebase.perf.network.FirebasePerfUrlConnection

# Kotlin Serialization
# kotlinx-serialization-core bundles its own rules for @Serializable classes
# (Companion, INSTANCE and serializer() lookups) in
# kotlinx-serialization-common.pro and kotlinx-serialization-r8.pro, so they do
# not need to be repeated here. Only the names of this app's own serializable
# members are kept - -keepclassmembernames is used rather than -keepnames so
# that the class names themselves can still be obfuscated.
-keepclassmembernames class com.neilturner.aerialviews.** {
    @kotlinx.serialization.Serializable *;
}

# Enum constant names
# Kotpref's enumValuePref/nullableEnumValuePref stores the constant *name* in
# SharedPreferences, the playlist cache stores enum names in database columns,
# and several overlays look constants up with valueOf() at runtime. Renaming a
# constant would silently reset the setting, so the constants are kept.
-keep enum com.neilturner.aerialviews.models.enums.** { *; }
-keep enum com.neilturner.aerialviews.services.weather.** { *; }

# SMB2Dialect constants are stored in preferences by name and looked up with
# valueOf() when the SMB config is built.
-keep enum com.hierynomus.mssmb2.SMB2Dialect { *; }

# Room
# Room resolves the generated implementation class by name using reflection, and
# the entity field names are used as the database column names.
-keep class com.neilturner.aerialviews.data.AerialDatabase { *; }
-keep class com.neilturner.aerialviews.data.**_Impl { *; }
-keep class com.neilturner.aerialviews.data.*Entity { *; }

-dontwarn org.apache.log4j.Level
-dontwarn org.apache.log4j.Logger
-dontwarn org.apache.log4j.Priority
-dontwarn org.apache.logging.log4j.Level
-dontwarn org.apache.logging.log4j.LogManager
-dontwarn org.apache.logging.log4j.Logger
-dontwarn org.apache.logging.log4j.message.MessageFactory
-dontwarn org.apache.logging.log4j.spi.ExtendedLogger
-dontwarn org.apache.logging.log4j.spi.ExtendedLoggerWrapper
-dontwarn org.slf4j.impl.StaticLoggerBinder**

-dontwarn javax.el.BeanELResolver**
-dontwarn javax.el.ELContext**
-dontwarn javax.el.ELResolver**
-dontwarn javax.el.ExpressionFactory**
-dontwarn javax.el.FunctionMapper**
-dontwarn javax.el.ValueExpression**
-dontwarn javax.el.VariableMapper**

-dontwarn org.ietf.jgss.GSSContext**
-dontwarn org.ietf.jgss.GSSCredential**
-dontwarn org.ietf.jgss.GSSException**
-dontwarn org.ietf.jgss.GSSManager**
-dontwarn org.ietf.jgss.GSSName**
-dontwarn org.ietf.jgss.Oid**

-dontwarn timber.log.Timber**

-dontwarn java.lang.management.ManagementFactory
-dontwarn java.lang.management.RuntimeMXBean
-dontwarn reactor.blockhound.integration.BlockHoundIntegration
